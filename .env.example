# ---- Supabase ----
# Project Settings > Data API > Project URL (bo phan /rest/v1/ o cuoi)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Project Settings > API Keys > Secret keys (project cu: service_role)
# CHI dung o server, KHONG BAO GIO de lo ra client
SUPABASE_SERVICE_ROLE_KEY=

# Nut Connect > Connection string > Transaction pooler (cong 6543)
DATABASE_URL=postgresql://postgres.xxxx:MATKHAU@aws-1-xx-xxxx-1.pooler.supabase.com:6543/postgres

# ---- Tai khoan admin (chi 1 nguoi) ----
ADMIN_EMAIL=admin@congty.vn
# Tao bang: npm run hash -- "matkhaucuaban"
# Dan NGUYEN dong script in ra. Moi dau $ phai co dau \ dang truoc, vi
# Next.js nap .env qua dotenv-expand va se hieu $2a, $12 la ten bien
# moi truong roi thay bang chuoi rong -> dang nhap luon that bai.
# Dung:  ADMIN_PASSWORD_HASH=\$2a\$12\$abc...
ADMIN_PASSWORD_HASH=
# Chuoi ngau nhien >= 32 ky tu. Tao bang:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
